{
  "name": "nusa-admin-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter demo dev --host",
    "build": "bun run meta && bun run build:lib && bun run build:demo && bun run build:docs && bun run build:mcp",
    "build:lib": "bun --filter nusa-admin build",
    "build:demo": "bun --filter demo build",
    "preview": "bun --filter demo preview",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter nusa-admin test && bun --filter nusa-admin-mcp test && bun --filter create-nusa-admin test",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run meta:check && bun run test && bun run build && bun run test:e2e",
    "meta": "bun scripts/gen-meta.ts",
    "dev:docs": "bun --filter docs dev",
    "build:docs": "bun --filter docs build",
    "build:mcp": "bun --filter nusa-admin-mcp build",
    "meta:check": "bun run meta && git diff --exit-code -- packages/ui/meta skills"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-component-meta": "^3.3.14",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  }
}
