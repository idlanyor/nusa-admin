{
  "name": "nusa-admin-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter demo dev",
    "build": "bun run build:lib && bun run build:demo",
    "build:lib": "bun --filter nusa-admin build",
    "build:demo": "bun --filter demo build",
    "preview": "bun --filter demo preview",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter nusa-admin test",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run test && bun run build && bun run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  }
}
