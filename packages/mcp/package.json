{
  "name": "nusa-admin-mcp",
  "version": "0.1.2",
  "description": "MCP server that teaches AI assistants the Nusa Admin components, guides and page recipes",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Roynaldi (Antidonasi Creative)",
    "email": "roy@irengcloud.com",
    "url": "https://roynaldi.website"
  },
  "homepage": "https://idlanyor.github.io/nusa-admin/guide/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idlanyor/nusa-admin.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/idlanyor/nusa-admin/issues"
  },
  "bin": {
    "nusa-admin-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "data": "bun scripts/copy-data.ts",
    "build": "bun run data && bun build src/bin.ts --target=node --outfile dist/server.js",
    "start": "bun src/bin.ts",
    "test": "bunx --bun vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nusa-admin",
    "vue",
    "ai",
    "claude"
  ]
}
