{
  "name": "nusa-admin",
  "version": "0.1.3",
  "description": "Reusable admin template kit for Vue 3 + Vite",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Roynaldi (Antidonasi Creative)",
    "email": "roy@irengcloud.com",
    "url": "https://roynaldi.website"
  },
  "homepage": "https://idlanyor.github.io/nusa-admin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idlanyor/nusa-admin.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/idlanyor/nusa-admin/issues"
  },
  "files": [
    "dist",
    "brand"
  ],
  "main": "./dist/nusa-admin.js",
  "module": "./dist/nusa-admin.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nusa-admin.js"
    },
    "./style.css": "./dist/nusa-admin.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0 || ^5.0.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "vite",
    "admin",
    "admin-template",
    "dashboard",
    "adminlte",
    "components",
    "ui-kit",
    "dark-mode",
    "rtl",
    "i18n"
  ]
}
